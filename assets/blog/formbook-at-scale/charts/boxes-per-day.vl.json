  "layer": [
    {
      "mark": {
        "type": "bar",
        "width": 120,
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": 0,
        "color": "#ffffff",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {
          "field": "boxes",
          "type": "quantitative",
          "stack": "zero",
          "bandPosition": 0.5
        },
        "text": {
          "field": "boxes",
          "type": "quantitative"
        },
        "color": {
          "value": "#ffffff"
        }
      }
