{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Horizontal bar chart of formbook agent runs by agent: claude 782 runs (97.1%), codex 23 runs (2.9%), 805 total.",
  "title": {
    "text": "805 agent runs: almost all of them Claude",
    "subtitle": [
      "newbox runs on formbook tasks (fb-*), by agent (Claude Code or Codex)",
      "Source: newbox state runs/*.json filtered to formbook. Collected 2026-10-15."
    ]
  },
  "width": 640,
  "height": 120,
  "config": {
    "background": "#ffffff",
    "padding": 16,
    "font": "IBM Plex Mono, ui-monospace, monospace",
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "start",
      "fontSize": 16,
      "color": "#111418",
      "subtitleColor": "#52514e",
      "subtitleFontSize": 12,
      "offset": 12
    },
    "axis": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "domainColor": "#adb5bd",
      "tickColor": "#adb5bd",
      "gridColor": "#e9ecef"
    },
    "legend": {
      "labelColor": "#52514e",
      "titleColor": "#52514e",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "orient": "top",
      "direction": "horizontal"
    }
  },
  "data": {
    "values": [
      {
        "agent": "claude",
        "runs": 782,
        "label": "782 runs (97.1%)"
      },
      {
        "agent": "codex",
        "runs": 23,
        "label": "23 runs (2.9%)"
      }
    ]
  },
  "encoding": {
    "y": {
      "field": "agent",
      "type": "nominal",
      "title": null,
      "sort": [
        "claude",
        "codex"
      ],
      "axis": {
        "labelFontSize": 13
      }
    },
    "x": {
      "field": "runs",
      "type": "quantitative",
      "title": "runs"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopRight": 4,
        "cornerRadiusBottomRight": 4,
        "height": 36
      },
      "encoding": {
        "color": {
          "field": "agent",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "claude",
              "codex"
            ],
            "range": [
              "#2a78d6",
              "#eb6834"
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "color": "#111418",
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
