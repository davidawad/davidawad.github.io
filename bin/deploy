#!/usr/bin/env bash
# Build the site locally and publish public/ to the gh-pages branch of the
# github remote (branch-based GitHub Pages; no CI, dot-aitman).
set -euo pipefail
cd "$(dirname "$0")/.."
remote="${DEPLOY_REMOTE:-git@github.com:davidawad/davidawad.github.io}"
sha=$(git rev-parse --short HEAD)
[ -d node_modules ] || corepack yarn install --immutable
rm -rf static/_jampack
corepack yarn build
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cp -R public/. "$tmp"/
touch "$tmp/.nojekyll"
echo davidaw.ad > "$tmp/CNAME"
git -C "$tmp" init -q -b gh-pages
git -C "$tmp" add -A
git -C "$tmp" -c user.name="${GIT_AUTHOR_NAME:-deploy}" -c user.email="${GIT_AUTHOR_EMAIL:-deploy@davidaw.ad}" commit -q -m "deploy $sha"
git -C "$tmp" push -f "$remote" gh-pages:gh-pages
echo "deployed $sha to gh-pages"
