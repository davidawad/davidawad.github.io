---
// concept-2.astro — "SEGMENTATION FAULT (core dumped)"
// Design bet: 404 as a kernel panic / debugger backtrace. IBM Plex Mono only.
// Fake-but-plausible stack frames using actual project names and domains.
// Adds a local --error color (semantic red) for the panic line only — the
// only token deviation, justified by needing a danger signal.
//
// Adapt: change `code` and `message` at the top.

import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

const code = 404;
const message = "Not Found";

const frames = [
  { num: "0", addr: "0x0000000000000000", fn: `resolve_path(uri="${code}")`, file: "router/dispatcher.rs:114" },
  { num: "1", addr: "0x00007f4a1c3d2e80", fn: `serve_content(req=0x00${code}200)`, file: "server/handler.rs:67" },
  { num: "2", addr: "0x00007f4a1c3d9a14", fn: "awad::middleware::log_request()", file: "src/middleware.ts:42" },
  { num: "3", addr: "0x00007f4a1c400ff0", fn: "Layout::render(slot=<not found>)", file: "src/layouts/Layout.astro:192" },
  { num: "4", addr: "0x00007f4a1deadbef", fn: "axethrow::software::main()", file: "axethrow/src/main.rs:1" },
  { num: "5", addr: "0x00007fffffffffff", fn: "__libc_start_main()", file: "??:0" },
];
---

<Layout title={`${code} ${message} | ${SITE.title}`}>
  <Header />

  <main id="main-content" class="crash-root app-layout pb-16 pt-6">
    <section class="crash-terminal" aria-label={`Error ${code}: crash dump`}>

      <!-- First prompt: the request that caused the fault -->
      <div class="crash-prompt" aria-hidden="true">
        <span class="crash-user">david@awad</span><span class="crash-sep">:</span><span class="crash-path">~/davidaw.ad</span><span class="crash-sep">$</span>
        <span class="crash-cmd">GET /{code} HTTP/1.1</span>
        <span class="crash-blink" aria-hidden="true"></span>
      </div>

      <!-- Panic line -->
      <div class="crash-panic" role="alert">
        <span class="crash-panic-sig">SIGSEGV</span>
        <span class="crash-panic-msg">Segmentation fault (core dumped)</span>
      </div>

      <!-- Process metadata -->
      <div class="crash-meta-block">
        <div class="crash-meta-row">
          <span class="crash-key">pid</span>
          <span class="crash-val">{code}</span>
        </div>
        <div class="crash-meta-row">
          <span class="crash-key">signal</span>
          <span class="crash-val">SIGSEGV (11)</span>
        </div>
        <div class="crash-meta-row">
          <span class="crash-key">fault addr</span>
          <span class="crash-val">0x0000000000{code}00</span>
        </div>
        <div class="crash-meta-row">
          <span class="crash-key">http</span>
          <span class="crash-val crash-err">{code} {message}</span>
        </div>
      </div>

      <div class="crash-divider" aria-hidden="true">────────────────────────────────────</div>

      <!-- Register dump -->
      <p class="crash-section-head">Registers:</p>
      <div class="crash-regs">
        <div class="crash-reg-row">
          <span class="crash-reg-name">rax</span>
          <span class="crash-reg-val">0x0000000000000000</span>
          <span class="crash-reg-name">rbx</span>
          <span class="crash-reg-val">0x000000000{code}c0de</span>
        </div>
        <div class="crash-reg-row">
          <span class="crash-reg-name">rip</span>
          <span class="crash-reg-val">0x00007f4a1c3d2e80</span>
          <span class="crash-reg-name">rsp</span>
          <span class="crash-reg-val">0x00007ffd8a3b2a10</span>
        </div>
        <div class="crash-reg-row">
          <span class="crash-reg-name">rdi</span>
          <span class="crash-reg-val">0xdeadbeef{code}e404</span>
          <span class="crash-reg-name">rsi</span>
          <span class="crash-reg-val">0xffffffffffffffff</span>
        </div>
      </div>

      <div class="crash-divider" aria-hidden="true">────────────────────────────────────</div>

      <!-- Stack trace -->
      <p class="crash-section-head">Stack trace (most recent call first):</p>
      <ol class="crash-frames" role="list">
        {frames.map(f => (
          <li class="crash-frame">
            <span class="crash-frame-num">#{f.num}</span>
            <span class="crash-frame-addr">{f.addr}</span>
            <span class="crash-frame-in">in</span>
            <span class="crash-frame-fn">{f.fn}</span>
            <span class="crash-frame-file">at {f.file}</span>
          </li>
        ))}
      </ol>

      <div class="crash-divider" aria-hidden="true">────────────────────────────────────</div>

      <!-- GDB prompt -->
      <div class="crash-gdb" aria-label="Debugger prompt">
        <span class="crash-gdb-prompt">(gdb)</span>
        <span class="crash-gdb-hint">_</span>
        <span class="crash-blink" aria-hidden="true"></span>
      </div>

      <!-- Recovery -->
      <div class="crash-recovery">
        <span class="crash-key">recovery</span>
        <a href="/" class="crash-home">[ navigate / ]</a>
        <span class="crash-key"> &middot; </span>
        <span class="crash-comment">// reboot from known-good state</span>
      </div>

    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Local semantic color for the panic line only — not in the site token set,
     but required to convey danger clearly in a terminal aesthetic. */
  .crash-root {
    --crash-error-light: #dc2626;
    --crash-error-dark: #f87171;
    --crash-error: var(--crash-error-light);
  }

  html[data-theme="dark"] .crash-root {
    --crash-error: var(--crash-error-dark);
  }

  /* ===== Terminal scaffold ===== */
  .crash-terminal {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--foreground);
    max-width: 100%;
  }

  /* ===== Prompt line ===== */
  .crash-prompt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3ch;
    padding: 0.45rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.25rem;
  }

  .crash-user {
    color: var(--accent);
    font-weight: 600;
  }

  .crash-sep {
    opacity: 0.45;
  }

  .crash-path {
    font-weight: 500;
  }

  .crash-cmd {
    opacity: 0.85;
  }

  /* ===== Blinking cursor ===== */
  .crash-blink {
    display: inline-block;
    width: 0.6ch;
    height: 1em;
    background: var(--accent);
    margin-left: 0.2ch;
    transform: translateY(0.15em);
    animation: blink 1.1s steps(2, start) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .crash-blink {
      animation: none;
    }
  }

  /* ===== Panic line ===== */
  .crash-panic {
    display: flex;
    align-items: baseline;
    gap: 1ch;
    margin-bottom: 1rem;
    padding: 0.5rem 0.75rem;
    border-left: 3px solid var(--crash-error);
    background: color-mix(in srgb, var(--crash-error) 8%, transparent);
  }

  .crash-panic-sig {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--crash-error);
    flex-shrink: 0;
  }

  .crash-panic-msg {
    color: var(--crash-error);
    font-weight: 600;
  }

  /* ===== Metadata block ===== */
  .crash-meta-block {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 0.25rem 2rem;
    margin-bottom: 1rem;
    padding: 0.5rem 0;
  }

  .crash-meta-row {
    display: flex;
    gap: 1.5ch;
    align-items: baseline;
  }

  .crash-key {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    min-width: 8ch;
    flex-shrink: 0;
  }

  .crash-val {
    color: var(--foreground);
    font-size: 0.83rem;
  }

  .crash-err {
    color: var(--crash-error);
    font-weight: 600;
  }

  /* ===== Divider ===== */
  .crash-divider {
    color: var(--border);
    font-size: 0.8rem;
    margin: 0.75rem 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0.7;
    letter-spacing: 0.05em;
  }

  /* ===== Section head ===== */
  .crash-section-head {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.5rem;
    opacity: 0.9;
  }

  /* ===== Register dump ===== */
  .crash-regs {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-bottom: 1rem;
    overflow-x: auto;
  }

  .crash-reg-row {
    display: flex;
    gap: 1.5ch;
    flex-wrap: wrap;
  }

  .crash-reg-name {
    color: var(--accent);
    min-width: 3ch;
    font-size: 0.82rem;
    opacity: 0.9;
  }

  .crash-reg-val {
    color: var(--foreground);
    font-size: 0.82rem;
    opacity: 0.75;
    min-width: 20ch;
    letter-spacing: 0.02em;
  }

  /* ===== Stack frames ===== */
  .crash-frames {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .crash-frame {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5ch 1.5ch;
    align-items: baseline;
    font-size: 0.82rem;
    padding: 0.2rem 0;
    border-bottom: 1px solid var(--border);
  }

  .crash-frame:last-child {
    border-bottom: none;
  }

  .crash-frame-num {
    color: var(--accent);
    min-width: 3ch;
    font-weight: 600;
    flex-shrink: 0;
  }

  .crash-frame-addr {
    color: var(--foreground);
    opacity: 0.45;
    font-size: 0.78rem;
    flex-shrink: 0;
    min-width: 20ch;
  }

  .crash-frame-in {
    opacity: 0.5;
    flex-shrink: 0;
  }

  .crash-frame-fn {
    color: var(--foreground);
    font-weight: 500;
    word-break: break-all;
  }

  .crash-frame-file {
    color: var(--foreground);
    opacity: 0.5;
    font-size: 0.76rem;
    width: 100%;
    padding-left: calc(3ch + 1.5ch + 20ch + 1.5ch + 2ch + 1.5ch);
    word-break: break-all;
  }

  /* ===== GDB prompt ===== */
  .crash-gdb {
    display: flex;
    align-items: baseline;
    gap: 1ch;
    margin-bottom: 1rem;
    padding: 0.4rem 0;
    border-top: 1px solid var(--border);
  }

  .crash-gdb-prompt {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.88rem;
  }

  .crash-gdb-hint {
    opacity: 0.3;
    font-size: 0.82rem;
  }

  /* ===== Recovery line ===== */
  .crash-recovery {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75ch;
    font-size: 0.82rem;
    margin-top: 0.25rem;
  }

  .crash-comment {
    opacity: 0.45;
    font-style: italic;
  }

  .crash-home {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dotted var(--accent);
    padding-bottom: 1px;
    transition: background 130ms ease, color 130ms ease;
  }

  .crash-home:hover,
  .crash-home:focus-visible {
    background: var(--accent);
    color: var(--background);
    border-bottom-color: transparent;
    outline: none;
  }

  /* ===== Responsive ===== */
  @media (max-width: 640px) {
    .crash-terminal {
      font-size: 0.78rem;
    }

    .crash-reg-val {
      min-width: 0;
    }

    .crash-frame-addr {
      display: none;
    }

    .crash-frame-file {
      padding-left: calc(3ch + 1.5ch + 2ch + 1.5ch);
    }
  }
</style>
