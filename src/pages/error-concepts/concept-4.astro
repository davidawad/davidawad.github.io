---
// concept-4.astro — "ILLEGAL MOVE — h9 does not exist"
// Design bet: 404 as an illegal chess move. The user navigated to a square
// that isn't on the board. A 4×4 board fragment (files e–h, ranks 5–8) plus
// a phantom rank-9 row floating ABOVE rank 8 (h9 sits above h8), annotated ??.
// Split layout: board left, algebraic notation right. IBM Plex Mono for
// notation, minimal decorative CSS-grid board.
//
// Adapt: change `code` and `message` at the top.

import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

const code = 404;
const message = "Not Found";

// ── Board data ──────────────────────────────────────────────────────────────
// 4×4 fragment: files e–h, ranks 8–5 (top to bottom in the grid).
// Squares are labeled by algebraic notation. A square is light when
// (fileIndex0 + rankIndex0) is odd (fileIndex0: a=0…h=7; rankIndex0: rank-1).

const ALL_FILES = ['a','b','c','d','e','f','g','h'];

type Piece = { sym: string; side: 'black' | 'white' };
// Black's position after 1.e4 e5 2.Nf3 Nc6 3.Bb5 d6 4.O-O Be7 5.Re1 Nf6,
// restricted to the visible fragment (files e–h, ranks 5–8).
const PIECES: Record<string, Piece> = {
  'e8': { sym: '♚', side: 'black' },
  'h8': { sym: '♜', side: 'black' },
  'e7': { sym: '♝', side: 'black' },
  'f7': { sym: '♟', side: 'black' },
  'g7': { sym: '♟', side: 'black' },
  'h7': { sym: '♟', side: 'black' },
  'f6': { sym: '♞', side: 'black' },
  'e5': { sym: '♟', side: 'black' },
};

const BOARD_FILES = ['e', 'f', 'g', 'h'];
const BOARD_RANKS = [8, 7, 6, 5]; // rendered top → bottom

interface Square {
  key: string;
  file: string;
  rank: number;
  isLight: boolean;
  piece: Piece | null;
  isHFile: boolean;
}

const squares: Square[] = BOARD_RANKS.flatMap((rank) =>
  BOARD_FILES.map((file) => {
    const fi0 = ALL_FILES.indexOf(file); // 0-based file index
    const ri0 = rank - 1;               // 0-based rank index
    const isLight = (fi0 + ri0) % 2 === 1;
    const key = `${file}${rank}`;
    return {
      key, file, rank, isLight,
      piece: PIECES[key] ?? null,
      isHFile: file === 'h',
    };
  })
);

// Phantom h9: the illegal destination — an off-board row floating above rank 8.
---

<Layout title={`${code} ${message} | ${SITE.title}`}>
  <Header />

  <main id="main-content" class="chess-root app-layout pb-16 pt-6">

    <div class="chess-layout">

      <!-- ── Left: board ───────────────────────────── -->
      <div class="chess-board-col">

        <!-- Headline -->
        <p class="chess-eyebrow">{code} {message}</p>
        <h1 class="chess-title">Illegal Move.</h1>

        <!-- Board: single grid (label column + 4 files) so rank labels always
             align with their rows. Phantom rank 9 floats ABOVE rank 8 —
             h9 is the square that would sit on top of h8 if it existed. -->
        <div
          class="chess-board-grid"
          role="img"
          aria-label="Chess board fragment, files e–h, ranks 5–8, with an off-board phantom rank 9 above it. The illegal square h9 is highlighted."
        >
          <!-- Phantom rank 9 row (off-board) -->
          <span class="chess-rank-lbl chess-rank-phantom" aria-hidden="true">9</span>
          {BOARD_FILES.map(f => (
            <div class={[
              'chess-sq',
              'chess-sq-phantom',
              f === 'h' ? 'chess-sq-illegal' : '',
            ].join(' ')} aria-hidden="true">
              {f === 'h' && (
                <span class="chess-illegal-marker">??</span>
              )}
            </div>
          ))}

          <!-- Real ranks 8 → 5 -->
          {BOARD_RANKS.map(rank => (
            <>
              <span class="chess-rank-lbl" aria-hidden="true">{rank}</span>
              {squares.filter(sq => sq.rank === rank).map(sq => (
                <div
                  class={[
                    'chess-sq',
                    'chess-sq-real',
                    sq.isLight ? 'chess-sq-light' : 'chess-sq-dark',
                    sq.isHFile ? 'chess-sq-hfile' : '',
                    sq.rank === 8 ? 'chess-sq-bt' : '',
                    sq.rank === 5 ? 'chess-sq-bb' : '',
                    sq.file === 'e' ? 'chess-sq-bl' : '',
                    sq.file === 'h' ? 'chess-sq-br' : '',
                  ].join(' ')}
                  aria-hidden="true"
                >
                  {sq.piece && (
                    <span class={`chess-piece chess-piece-${sq.piece.side}`}>
                      {sq.piece.sym}
                    </span>
                  )}
                </div>
              ))}
            </>
          ))}

          <!-- File labels -->
          <span aria-hidden="true"></span>
          {BOARD_FILES.map(f => (
            <span class={`chess-file-lbl${f === 'h' ? ' chess-file-h' : ''}`} aria-hidden="true">{f}</span>
          ))}
        </div>

        <!-- Caption -->
        <p class="chess-caption">
          h9 is not a legal square. Ranks end at 8.
        </p>

      </div>

      <!-- ── Right: notation ───────────────────────── -->
      <div class="chess-notation-col">

        <p class="chess-notation-label">MOVE LIST</p>

        <!-- Move table -->
        <div class="chess-move-table" role="table" aria-label="Game move list">

          <div class="chess-move-header" role="row">
            <span role="columnheader">#</span>
            <span role="columnheader">WHITE</span>
            <span role="columnheader">BLACK</span>
          </div>

          {[
            { num: '1', white: 'e4',   black: 'e5'   },
            { num: '2', white: 'Nf3',  black: 'Nc6'  },
            { num: '3', white: 'Bb5',  black: 'd6'   },
            { num: '4', white: 'O-O',  black: 'Be7'  },
            { num: '5', white: 'Re1',  black: 'Nf6'  },
          ].map(m => (
            <div class="chess-move-row" role="row">
              <span class="chess-move-num" role="cell">{m.num}.</span>
              <span class="chess-move-san" role="cell">{m.white}</span>
              <span class="chess-move-san" role="cell">{m.black}</span>
            </div>
          ))}

          <!-- The illegal move: Black's h8 rook tries to leave the board -->
          <div class="chess-move-row chess-move-illegal" role="row">
            <span class="chess-move-num" role="cell">6.</span>
            <span class="chess-move-san" role="cell">d4</span>
            <span class="chess-move-san chess-move-err" role="cell">Rh9<span class="chess-ann">??</span></span>
          </div>
        </div>

        <!-- Error annotation -->
        <div class="chess-error-block" role="alert">
          <p class="chess-error-title">ILLEGAL POSITION</p>
          <p class="chess-error-body">
            Square h9 is outside the 8&times;8 board.
            HTTP {code}: {message}.
          </p>
          <p class="chess-error-annotation">
            <span class="chess-ann-sym">??</span>
            &mdash; catastrophic error, equivalent to resigning.
          </p>
        </div>

        <!-- Home link -->
        <div class="chess-resign">
          <span class="chess-resign-label">1&ndash;0</span>
          <a href="/" class="chess-home">resign &amp; return to &#9812;&#8201;1</a>
        </div>

      </div>
    </div>

  </main>

  <Footer />
</Layout>

<style>
  /* ===== Two-column layout ===== */
  .chess-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
    max-width: 52rem;
  }

  /* ===== Board column ===== */
  .chess-board-col {
    display: flex;
    flex-direction: column;
  }

  .chess-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.35rem;
  }

  .chess-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    margin: 0 0 1.25rem;
    line-height: 1.05;
    color: var(--foreground);
  }

  /* Single grid: rank-label column + 4 file columns. Labels are grid cells
     in the same row as their squares, so alignment is structural — no
     min-height approximations. */
  .chess-board-grid {
    display: grid;
    grid-template-columns: 1.5rem repeat(4, 1fr);
    user-select: none;
  }

  .chess-rank-lbl {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--foreground);
    opacity: 0.55;
    line-height: 1;
  }

  .chess-rank-phantom {
    color: var(--accent);
    opacity: 1;
    font-weight: 600;
  }

  /* Board edge borders live on the edge squares themselves */
  .chess-sq-bt { border-top: 2px solid var(--border); }
  .chess-sq-bb { border-bottom: 2px solid var(--border); }
  .chess-sq-bl { border-left: 2px solid var(--border); }
  .chess-sq-br { border-right: 2px solid var(--border); }

  .chess-sq {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: background 150ms ease;
  }

  .chess-sq-light {
    background: color-mix(in srgb, var(--accent) 8%, var(--background));
  }

  .chess-sq-dark {
    background: color-mix(in srgb, var(--foreground) 18%, var(--background));
  }

  html[data-theme="dark"] .chess-sq-light {
    background: color-mix(in srgb, var(--accent) 12%, var(--muted));
  }

  html[data-theme="dark"] .chess-sq-dark {
    background: color-mix(in srgb, var(--foreground) 20%, var(--background));
  }

  /* h-file squares get a faint accent tint to draw the eye */
  .chess-sq-hfile.chess-sq-light {
    background: color-mix(in srgb, var(--accent) 15%, var(--background));
  }

  .chess-sq-hfile.chess-sq-dark {
    background: color-mix(in srgb, var(--accent) 10%, var(--muted));
  }

  /* Pieces */
  .chess-piece {
    font-size: clamp(1.2rem, 4vw, 1.75rem);
    line-height: 1;
    display: block;
  }

  .chess-piece-white {
    color: var(--background);
    text-shadow: 0 0 1px var(--foreground);
  }

  .chess-piece-black {
    color: var(--foreground);
  }

  /* Phantom rank 9 squares — off-board, floating above rank 8 */
  .chess-sq-phantom {
    aspect-ratio: 1.5 / 1;
    /* intentionally flatter — rank 9 is "compressed", off-board */
    background: var(--muted);
    border: 1px dashed var(--border);
    opacity: 0.5;
    margin-bottom: 0.4rem;
  }

  /* The illegal h9 square */
  .chess-sq-illegal {
    background: color-mix(in srgb, var(--accent) 20%, var(--background));
    opacity: 1;
    border-color: var(--accent);
    animation: illegal-pulse 2.5s ease-in-out infinite;
  }

  @keyframes illegal-pulse {
    0%, 100% { background: color-mix(in srgb, var(--accent) 20%, var(--background)); }
    50%      { background: color-mix(in srgb, var(--accent) 35%, var(--background)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .chess-sq-illegal { animation: none; }
  }

  .chess-illegal-marker {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  /* File labels */
  .chess-file-lbl {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--foreground);
    opacity: 0.55;
    text-align: center;
    padding-top: 0.3rem;
  }

  .chess-file-h {
    color: var(--accent);
    opacity: 1;
    font-weight: 600;
  }

  .chess-caption {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--foreground);
    opacity: 0.55;
    margin: 0.75rem 0 0;
  }

  /* ===== Notation column ===== */
  .chess-notation-col {
    padding-top: 0.5rem;
  }

  .chess-notation-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.65rem;
    font-weight: 600;
  }

  /* Move table */
  .chess-move-table {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    width: 100%;
    border-top: 1px solid var(--border);
    margin-bottom: 1.25rem;
  }

  .chess-move-header {
    display: grid;
    grid-template-columns: 3ch 1fr 1fr;
    gap: 0.5ch;
    padding: 0.35rem 0;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.75;
    border-bottom: 1px solid var(--border);
  }

  .chess-move-row {
    display: grid;
    grid-template-columns: 3ch 1fr 1fr;
    gap: 0.5ch;
    padding: 0.35rem 0;
    border-bottom: 1px dashed var(--border);
    align-items: baseline;
    color: var(--foreground);
  }

  .chess-move-num {
    opacity: 0.45;
    font-size: 0.8rem;
  }

  .chess-move-san {
    font-size: 0.9rem;
  }

  .chess-move-illegal {
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }

  .chess-move-err {
    color: var(--accent);
    font-weight: 600;
  }

  .chess-ann {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
    opacity: 0.85;
  }

  .chess-move-none {
    opacity: 0.3;
  }

  /* Error annotation block */
  .chess-error-block {
    border: 1px solid var(--accent);
    padding: 0.85rem 1rem;
    margin-bottom: 1.25rem;
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }

  .chess-error-title {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.45rem;
    font-weight: 600;
  }

  .chess-error-body {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--foreground);
    margin: 0 0 0.5rem;
  }

  .chess-error-annotation {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--foreground);
    opacity: 0.65;
    margin: 0;
    font-style: italic;
  }

  .chess-ann-sym {
    font-style: normal;
    font-weight: 700;
    color: var(--accent);
  }

  /* Resign / home link */
  .chess-resign {
    display: flex;
    align-items: baseline;
    gap: 1ch;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .chess-resign-label {
    color: var(--foreground);
    opacity: 0.5;
    font-weight: 600;
    flex-shrink: 0;
  }

  .chess-home {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dashed var(--accent);
    padding-bottom: 1px;
    transition: opacity 140ms ease;
  }

  .chess-home:hover,
  .chess-home:focus-visible {
    opacity: 0.65;
  }

  /* ===== Responsive ===== */
  @media (max-width: 680px) {
    .chess-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .chess-notation-col {
      padding-top: 0;
    }

    .chess-board-grid {
      grid-template-columns: 1.25rem repeat(4, 1fr);
    }
  }
</style>
