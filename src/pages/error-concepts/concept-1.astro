---
// concept-1.astro — "IN RE: THE MISSING PAGE"
// Design bet: 404 as a formal federal court opinion. Serif-dominant, document-
// layout with a real case caption, numbered findings, wherefore clause, and a
// signature block. The attorney identity made structural, not decorative.
//
// Adapt to other codes: change `code` and `message` at the top.

import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

const code = 404;
const message = "Not Found";
const caseNo = `${code}-${message.toUpperCase().replace(/\s+/g, "-")}`;
---

<Layout title={`${code} ${message} | ${SITE.title}`}>
  <Header />

  <main id="main-content" class="brief-root">
    <div class="brief-doc" role="main" aria-label={`Error ${code}: ${message}`}>

      <!-- Court header -->
      <p class="brief-court">UNITED STATES DISTRICT COURT</p>
      <p class="brief-division">INTERNET DIVISION &mdash; WORLD WIDE WEB</p>
      <div class="brief-rule-heavy"></div>

      <!-- Case caption -->
      <div class="brief-caption">
        <div class="brief-parties">
          <p class="brief-party-name">THE USER,</p>
          <p class="brief-party-role">Plaintiff,</p>
          <p class="brief-vs">v.</p>
          <p class="brief-party-name">THIS URL,</p>
          <p class="brief-party-role">Defendant.</p>
        </div>
        <div class="brief-docket">
          <div class="brief-docket-row">
            <span class="brief-docket-label">CASE NO.</span>
            <span class="brief-docket-val brief-accent">{caseNo}</span>
          </div>
          <div class="brief-docket-row">
            <span class="brief-docket-label">STATUS</span>
            <span class="brief-docket-val">{code} {message}</span>
          </div>
          <div class="brief-docket-row">
            <span class="brief-docket-label">VENUE</span>
            <span class="brief-docket-val">davidaw.ad</span>
          </div>
        </div>
      </div>

      <div class="brief-rule-heavy"></div>

      <!-- Opinion title -->
      <h1 class="brief-title">In re: The Missing Page</h1>
      <p class="brief-subtitle">Opinion of the Court &middot; Per Curiam</p>

      <div class="brief-rule-dashed"></div>

      <!-- Background -->
      <p class="brief-section-label">BACKGROUND</p>
      <p class="brief-body">
        This matter arises from Plaintiff&rsquo;s good-faith attempt to access a resource at the above-captioned URL. The Court has reviewed the request in its entirety and finds no responsive content within its jurisdiction.
      </p>

      <div class="brief-rule-dashed"></div>

      <!-- Findings -->
      <p class="brief-section-label">FINDINGS OF FACT</p>
      <ol class="brief-findings">
        <li>The URL requested by Plaintiff does not exist within the jurisdiction of this server and has not existed at any prior time material to this action.</li>
        <li>No redirect, alias, or forwarding rule was located that would cure Defendant&rsquo;s absence or provide Plaintiff with substantially similar relief.</li>
        <li>The Court has searched diligently and found no content responsive to the instant request, including in cache, adjacent routes, and alternate representations.</li>
        <li>This deficiency is not attributable to any act or omission of Plaintiff but arises solely from the fundamental nonexistence of the requested resource.</li>
      </ol>

      <div class="brief-rule-dashed"></div>

      <!-- Conclusion -->
      <p class="brief-section-label">CONCLUSION</p>
      <p class="brief-body">
        For the foregoing reasons, the Court enters judgment in favor of neither party and finds HTTP/1.1 <strong>{code} {message}</strong> to be the appropriate disposition. Plaintiff is directed to navigate home and initiate a new request from lawful premises.
      </p>

      <p class="brief-ordered">
        IT IS SO ORDERED AND ADJUDGED.
      </p>

      <!-- Signature block -->
      <div class="brief-sig">
        <div class="brief-sig-line"></div>
        <p class="brief-sig-name">David Awad, Esq.</p>
        <p class="brief-sig-title">Attorney at Law &middot; Site Owner &middot; Acting as Judge</p>
        <p class="brief-sig-bar">Cal. Bar No. [redacted] &middot; CA, US</p>
      </div>

      <div class="brief-rule-heavy"></div>

      <a href="/" class="brief-home">
        &larr; return to jurisdiction
      </a>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Root: center the document on the page ===== */
  .brief-root {
    display: flex;
    justify-content: center;
    padding: 3rem 1rem 5rem;
    min-height: 55vh;
  }

  /* ===== The document itself ===== */
  .brief-doc {
    max-width: 44rem;
    width: 100%;
    padding: 2.75rem 3rem;
    background: var(--muted);
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
  }

  /* ===== Court header ===== */
  .brief-court {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-align: center;
    color: var(--foreground);
    margin: 0 0 0.2rem;
  }

  .brief-division {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-align: center;
    color: var(--accent);
    margin: 0 0 0.9rem;
  }

  /* ===== Rules ===== */
  .brief-rule-heavy {
    border-top: 2px solid var(--foreground);
    border-bottom: 1px solid var(--foreground);
    height: 4px;
    margin: 0.6rem 0;
  }

  .brief-rule-dashed {
    border-top: 1px dashed var(--border);
    margin: 1.5rem 0;
  }

  /* ===== Case caption ===== */
  .brief-caption {
    display: flex;
    gap: 2rem;
    margin: 1rem 0;
    align-items: flex-start;
  }

  .brief-parties {
    flex: 1;
    font-family: var(--font-serif);
  }

  .brief-party-name {
    font-size: 0.95rem;
    font-style: italic;
    margin: 0.1rem 0;
    color: var(--foreground);
  }

  .brief-party-role {
    font-size: 0.82rem;
    opacity: 0.65;
    margin: 0 0 0.55rem 1.5rem;
    font-style: normal;
  }

  .brief-vs {
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0.35rem 0;
    font-style: italic;
    color: var(--foreground);
  }

  .brief-docket {
    min-width: 11rem;
    border-left: 1px solid var(--border);
    padding-left: 1.25rem;
    font-family: var(--font-mono);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .brief-docket-row {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }

  .brief-docket-label {
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .brief-docket-val {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--foreground);
  }

  .brief-accent {
    color: var(--accent);
  }

  /* ===== Opinion title ===== */
  .brief-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 5vw, 2.6rem);
    font-weight: 700;
    text-align: center;
    margin: 1.4rem 0 0.3rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--foreground);
  }

  .brief-subtitle {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-align: center;
    color: var(--accent);
    margin: 0 0 1rem;
  }

  /* ===== Section labels ===== */
  .brief-section-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.75rem;
    font-weight: 600;
  }

  /* ===== Body text ===== */
  .brief-body {
    font-family: var(--font-serif);
    font-size: 0.96rem;
    line-height: 1.75;
    color: var(--foreground);
    margin: 0 0 0.75rem;
    text-align: justify;
  }

  .brief-body strong {
    font-weight: 700;
  }

  /* ===== Numbered findings ===== */
  .brief-findings {
    font-family: var(--font-serif);
    font-size: 0.94rem;
    line-height: 1.72;
    padding-left: 1.8rem;
    margin: 0;
    color: var(--foreground);
    text-align: justify;
  }

  .brief-findings li {
    margin-bottom: 0.65rem;
  }

  /* ===== Ordered / conclusion ===== */
  .brief-ordered {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-style: italic;
    font-weight: 600;
    text-align: center;
    margin: 1.5rem 0;
    padding: 0.8rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    color: var(--foreground);
  }

  /* ===== Signature block ===== */
  .brief-sig {
    margin: 1.75rem 0 1.25rem;
    text-align: right;
  }

  .brief-sig-line {
    width: 15rem;
    border-top: 1px solid var(--foreground);
    margin: 0 0 0.35rem auto;
  }

  .brief-sig-name {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-style: italic;
    margin: 0;
    color: var(--foreground);
  }

  .brief-sig-title {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    opacity: 0.65;
    margin: 0.2rem 0 0;
  }

  .brief-sig-bar {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    opacity: 0.45;
    margin: 0.1rem 0 0;
  }

  /* ===== Home link ===== */
  .brief-home {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dashed var(--accent);
    padding-bottom: 1px;
    transition: opacity 150ms ease;
  }

  .brief-home:hover,
  .brief-home:focus-visible {
    opacity: 0.65;
  }

  /* ===== Responsive ===== */
  @media (max-width: 540px) {
    .brief-doc {
      padding: 1.75rem 1.25rem;
      border-left: none;
      border-right: none;
    }

    .brief-caption {
      flex-direction: column;
      gap: 1rem;
    }

    .brief-docket {
      border-left: none;
      border-top: 1px solid var(--border);
      padding-left: 0;
      padding-top: 0.85rem;
    }
  }
</style>
