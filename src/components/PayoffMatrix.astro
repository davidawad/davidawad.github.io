---
// PayoffMatrix — a 2×2 game-theory payoff matrix in the site's mono/terminal
// visual language. Extracted from the "Dominant Strategy: Not Found" error
// page concept for reuse in blog posts (via MDX) and other pages.
//
// Strictly 2×2: the border logic below (nth-child) assumes a 3×3 grid of
// corner + 2 col heads + 2 × (row head + 2 cells).
//
// Usage:
//   <PayoffMatrix
//     rowPlayer="YOU" colPlayer="MARKET"
//     cols={[{ label: "EDGE IS REAL" }, { label: "EDGE IS IMAGINED" }]}
//     rows={[{ label: "PLAY", sub: "you commit" }, { label: "PASS", sub: "you sit out" }]}
//     cells={[
//       [{ payoff: "(alpha, −alpha)", note: "zero sum", here: true, hereTag: "▶ aim here" }, { payoff: "(−tuition, +alpha)" }],
//       [{ payoff: "(∅, ∅)" }, { payoff: "(∅, ∅)" }],
//     ]}
//     caption="Payoffs: (you, market)."
//   />

interface HeadCell {
  label: string;
  sub?: string;
}

interface Cell {
  payoff: string;
  note?: string;
  here?: boolean;
  hereTag?: string;
}

interface Props {
  rowPlayer: string;
  colPlayer: string;
  cols: [HeadCell, HeadCell];
  rows: [HeadCell, HeadCell];
  cells: [[Cell, Cell], [Cell, Cell]];
  caption?: string;
}

const { rowPlayer, colPlayer, cols, rows, cells, caption } = Astro.props;
---

<div class="matrix-wrap" role="region" aria-label={`2×2 payoff matrix: ${rowPlayer} vs ${colPlayer}`}>

  <div class="matrix-grid">

    <!-- Top-left corner (label area). With the "\" diagonal, the column
         player sits top-right and the row player bottom-left. -->
    <div class="matrix-corner">
      <span class="matrix-corner-col">{colPlayer}</span>
      <span class="matrix-corner-divider" aria-hidden="true">\</span>
      <span class="matrix-corner-row">{rowPlayer}</span>
    </div>

    <!-- Column headers -->
    {cols.map(col => (
      <div class="matrix-col-head">
        <span class="matrix-col-label">{col.label}</span>
        {col.sub && <span class="matrix-col-sub">{col.sub}</span>}
      </div>
    ))}

    {rows.map((row, r) => (
      <>
        <div class="matrix-row-head">
          <span class="matrix-row-label">{row.label}</span>
          {row.sub && <span class="matrix-row-sub">{row.sub}</span>}
        </div>

        {cells[r].map(cell => (
          <div class={`matrix-cell${cell.here ? ' matrix-cell-here' : ''}`}>
            {cell.here && (
              <span class="matrix-here-tag" aria-label="highlighted cell">{cell.hereTag ?? '▶ HERE'}</span>
            )}
            <span class="matrix-payoff">{cell.payoff}</span>
            {cell.note && <span class="matrix-note">{cell.note}</span>}
          </div>
        ))}
      </>
    ))}

  </div>

  {caption && <p class="matrix-key">{caption}</p>}
</div>

<style>
  .matrix-wrap {
    margin: 1.75rem 0;
    overflow-x: auto;
  }

  /* 3×3 grid: 1 corner + 2 col-heads + 2 × (1 row-head + 2 cells) */
  .matrix-grid {
    display: grid;
    grid-template-columns: 9rem 1fr 1fr;
    border: 2px solid var(--foreground);
    min-width: 28rem;
    width: 100%;
    max-width: 40rem;
  }

  /* ===== Corner cell ===== */
  .matrix-corner {
    background: var(--muted);
    border-right: 2px solid var(--foreground);
    border-bottom: 2px solid var(--foreground);
    padding: 0.6rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 4rem;
  }

  .matrix-corner-col {
    align-self: flex-end;
    letter-spacing: 0.18em;
    color: var(--foreground);
    opacity: 0.6;
  }

  .matrix-corner-divider {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.2rem;
    opacity: 0.25;
    color: var(--foreground);
  }

  .matrix-corner-row {
    letter-spacing: 0.18em;
    color: var(--foreground);
    opacity: 0.6;
  }

  /* ===== Column headers ===== */
  .matrix-col-head {
    background: var(--muted);
    border-right: 1px solid var(--border);
    border-bottom: 2px solid var(--foreground);
    padding: 0.6rem 0.75rem;
    font-family: var(--font-mono);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: center;
  }

  /* Second column header is the 3rd grid child */
  .matrix-col-head:nth-child(3) {
    border-right: none;
  }

  .matrix-col-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--foreground);
  }

  .matrix-col-sub {
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    opacity: 0.5;
    text-transform: uppercase;
  }

  /* ===== Row headers ===== */
  .matrix-row-head {
    background: var(--muted);
    border-right: 2px solid var(--foreground);
    border-bottom: 1px solid var(--border);
    padding: 0.7rem 0.75rem;
    font-family: var(--font-mono);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  /* Second row head is the 7th grid child */
  .matrix-row-head:nth-child(7) {
    border-bottom: none;
  }

  .matrix-row-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--foreground);
  }

  .matrix-row-sub {
    font-size: 0.63rem;
    letter-spacing: 0.04em;
    opacity: 0.5;
    text-transform: uppercase;
  }

  /* ===== Cells ===== */
  .matrix-cell {
    padding: 0.7rem 0.75rem;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    position: relative;
  }

  /* Grid children order: corner(1) | col-head(2) | col-head(3)
     | row-head(4) | cell(5) | cell(6) | row-head(7) | cell(8) | cell(9)
     Last-column cells are at positions 6 and 9. Last-row cells: 8 and 9. */
  .matrix-cell:nth-child(6),
  .matrix-cell:nth-child(9) {
    border-right: none;
  }

  .matrix-cell:nth-child(8),
  .matrix-cell:nth-child(9) {
    border-bottom: none;
  }

  /* The highlighted cell */
  .matrix-cell-here {
    background: color-mix(in srgb, var(--accent) 10%, var(--background));
    border-color: var(--accent);
  }

  .matrix-here-tag {
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
  }

  .matrix-payoff {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--foreground);
    letter-spacing: 0.02em;
  }

  .matrix-cell-here .matrix-payoff {
    color: var(--accent);
  }

  .matrix-note {
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  /* ===== Caption ===== */
  .matrix-key {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    opacity: 0.5;
    margin: 0.5rem 0 0;
    color: var(--foreground);
  }

  /* ===== Responsive ===== */
  @media (max-width: 600px) {
    .matrix-grid {
      grid-template-columns: 7rem 1fr 1fr;
    }

    .matrix-corner,
    .matrix-col-head,
    .matrix-row-head,
    .matrix-cell {
      padding: 0.5rem 0.5rem;
    }
  }
</style>
