---
import { SITE } from "@config";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Layout from "@layouts/Layout.astro";
import { projects, type Project } from "@/data/engineering";
import { engineeringStrings } from "@/data/engineering-i18n";
import type { LocaleKey } from "@/i18n/config";

// Shared, locale-aware Engineering page. Rendered by
// src/pages/engineering.astro and the /ar, /zh wrappers.
interface Props {
  locale: LocaleKey;
}

const { locale } = Astro.props;
const s = engineeringStrings[locale];
const isRTL = locale === "ar";
const prefix = locale === "en" ? "" : `/${locale}`;

// ============================================================
// Permission-string encoder — actually encodes truthful metadata.
//
// Position 0: type
//   d = deployed product (has a live URL not pointing to github.com)
//   - = code-only repo (github or no link)
//
// Owner triplet (positions 1-3): the project owner's relationship to the code
//   r = has README (true for every github repo — all do)
//   w = actively maintained (last commit within last 2 years of now → 2024+)
//   x = executable / shipped artifact (vs research code / coursework)
//
// Group triplet (positions 4-6): "open to collaborators"
//   r = open-source (public repo)
//   w = accepts pull requests (any public github repo)
//   - = closed to group writes if it's a deployed product with no repo
//
// World triplet (positions 7-9): publicly shipped to end users
//   r = anyone can read / view the artifact
//   - or x = anyone can execute it (live deployed product)
//   - = source-only, no public deployment
//
// Tasks: research / coursework category (ml + physics from school) = no x bit
// Embedded = x (it ran on real hardware)
// Web with live URL = x in world bit (live site)
// ============================================================

const CURRENT_YEAR = new Date().getFullYear();

function isDeployed(p: Project): boolean {
  if (p.siteUrl) return true;
  if (p.repoUrl || !p.url) return false;
  return !p.url.includes("github.com") && !p.url.includes("gitlab.com");
}

function isCoursework(p: Project): boolean {
  // ml + physics projects from 2016-2018 are Udacity / undergrad coursework
  return (p.category === "ml" || p.category === "physics");
}

function hasRepo(p: Project): boolean {
  return !!p.repoUrl || (!!p.url && (p.url.includes("github.com") || p.url.includes("gitlab.com")));
}

function encodePerms(p: Project): string {
  // type bit
  const type = isDeployed(p) ? "d" : "-";

  // owner: r-w-x
  const ownerR = hasRepo(p) || isDeployed(p) ? "r" : "-";
  const ownerW = (CURRENT_YEAR - p.year) <= 2 ? "w" : "-";
  const ownerX = isCoursework(p) ? "-" : "x";

  // group: r-w-x (open to collaborators)
  const groupR = hasRepo(p) ? "r" : "-";
  const groupW = hasRepo(p) ? "w" : "-";
  const groupX = "-";

  // world: r-w-x (publicly shipped)
  const worldR = hasRepo(p) || isDeployed(p) ? "r" : "-";
  const worldW = "-";
  const worldX = isDeployed(p) ? "x" : "-";

  return `${type}${ownerR}${ownerW}${ownerX}${groupR}${groupW}${groupX}${worldR}${worldW}${worldX}`;
}

// Sort by publication date descending; legacy entries fall back to their year.
const sortedProjects = [...projects].sort((a, b) => {
  const dateA = a.publishedDate ?? `${a.year}-01-01`;
  const dateB = b.publishedDate ?? `${b.year}-01-01`;
  return dateB.localeCompare(dateA);
});

// Render-ready rows — blurbs fall back to EN when a translation is missing
const rows = sortedProjects.map(p => ({
  ...p,
  blurb: s.blurbs[p.name] ?? p.blurb,
  perms: encodePerms(p),
  owner: "david",
  isVideo: p.img.endsWith(".mp4"),
  totalBlocks: 1,
}));

// Format: total <N>  (mirrors `ls -la` header)
const totalLine = `total ${rows.length}`;
---

<Layout title={`${s.pageTitle} | ${SITE.title}`} llmUrl={`${prefix}/engineering/llms.txt`}>
  <Header />
  <main id="main-content" class="app-layout pb-16 pt-6">
    <section class="terminal" aria-label="Engineering projects rendered as a terminal session">

      <!-- =======================  HERO  ======================= -->
      <div class="prompt-line" aria-hidden="true">
        <span class="prompt-user">david@awad</span>
        <span class="prompt-sep">:</span>
        <span class="prompt-path">~/projects</span>
        <span class="prompt-sep">$</span>
        <span class="prompt-cmd">ls -la --sort=year</span>
        <span class="caret" aria-hidden="true"></span>
      </div>

      <!-- Kept for a11y/SEO document structure, but visually hidden — the
           "ls -la --sort=year" prompt above is the real identity statement
           now, no separate serif title needed on top of it. -->
      <h1 class="sr-only" dir="auto">{s.identity}</h1>

      <!-- =======================  MAN-PAGE PREAMBLE  ======================= -->
      <div class="manpage" role="region" aria-label="About this listing">
        <pre class={`man-block${isRTL ? " man-block-bidi" : ""}`}>{s.manText}</pre>
      </div>

      <!-- =======================  SECOND PROMPT  ======================= -->
      <div class="prompt-line subsequent" aria-hidden="true">
        <span class="prompt-user">david@awad</span>
        <span class="prompt-sep">:</span>
        <span class="prompt-path">~/projects</span>
        <span class="prompt-sep">$</span>
        <span class="prompt-cmd">ls -la --sort=year --long</span>
      </div>

      <!-- =======================  LISTING  ======================= -->
      <div class="listing-total">{totalLine}</div>

      <ol class="listing" role="list">
        {rows.map((p, idx) => {
          const rowId = `proj-${idx}`;
          const mediaId = `media-${idx}`;
          const labelInner = (
            <>
              <span class="col-perms" aria-label={`permissions ${p.perms}`}>{p.perms}</span>
              <span class="col-owner">{p.owner}</span>
              <span class="col-year">{p.year}</span>
              <span class={`col-cat cat-${p.category}`}>{p.category}</span>
              <span class="col-name">{p.name}</span>
            </>
          );
          return (
            <li class="row" data-row={rowId}>
              <button
                type="button"
                class="row-toggle"
                aria-expanded="false"
                aria-controls={mediaId}
                data-target={mediaId}
              >
                <span class="row-line">
                  <span class="col-chevron" aria-hidden="true">+</span>
                  {labelInner}
                </span>
                <span class="row-blurb" dir="auto">{p.blurb}</span>
              </button>

              <div class="row-meta">
                {p.siteUrl && (
                  <a class="row-link" href={p.siteUrl} target="_blank" rel="noopener noreferrer">
                    <span aria-hidden="true">[ </span>{s.openSite}<span aria-hidden="true"> ]</span>
                  </a>
                )}
                {p.repoUrl ? (
                  <a class="row-link" href={p.repoUrl} target="_blank" rel="noopener noreferrer">
                    <span aria-hidden="true">[ </span>{s.openSource}<span aria-hidden="true"> ]</span>
                  </a>
                ) : p.url && !p.siteUrl ? (
                  <a class="row-link" href={p.url} target="_blank" rel="noopener noreferrer">
                    <span aria-hidden="true">[ </span>{isDeployed(p) ? s.openSite : s.openSource}<span aria-hidden="true"> ]</span>
                  </a>
                ) : !p.siteUrl ? (
                  <span class="row-link row-link-disabled" aria-disabled="true">
                    <span aria-hidden="true">[ </span>{s.notPublished}<span aria-hidden="true"> ]</span>
                  </span>
                ) : null}
                {p.publishedDate && <time class="project-date" dateTime={p.publishedDate}>published {p.publishedDate}</time>}
                {p.license && <span class="project-license">{s.licenseLabel}: {p.license}</span>}
                {p.tags && <span class="project-tags">{s.tagsLabel}: {p.tags.join(" · ")}</span>}
              </div>

              <div id={mediaId} class="row-media" hidden>
                {p.isVideo ? (
                  <video
                    src={p.img}
                    muted
                    autoplay
                    loop
                    playsinline
                    preload="metadata"
                    aria-label={`Demo video for ${p.name}`}
                  ></video>
                ) : (
                  <img
                    src={p.img}
                    alt={`Screenshot of ${p.name} — ${p.blurb}`}
                    loading="lazy"
                  />
                )}
                {p.terminalImg && (
                  <img
                    src={p.terminalImg}
                    alt={`Terminal demo for ${p.name}`}
                    loading="lazy"
                  />
                )}
              </div>
            </li>
          );
        })}
      </ol>

      <!-- =======================  FOOTER PROMPT  ======================= -->
      <div class="prompt-line subsequent" aria-hidden="true">
        <span class="prompt-user">david@awad</span>
        <span class="prompt-sep">:</span>
        <span class="prompt-path">~/projects</span>
        <span class="prompt-sep">$</span>
        <span class="prompt-cmd">mail -s "found a bug" david@awad.esq</span>
      </div>

      <p class="closing" dir="auto">
        {s.closingLead}
        <a href="mailto:david@awad.esq">david@awad.esq</a>
        {s.closingOr}
        <a href="https://twitter.com/realdavidawad" target="_blank" rel="noopener noreferrer">@realdavidawad</a>.
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* ============================================================
     Terminal-as-portfolio styling.
     Stays on the brand palette (white/navy light, dark/light-blue dark).
     IBM Plex Mono throughout. ONE serif accent on the H1-equivalent
     ("NAME" line in the man page) — earned because it anchors the
     identity statement.
     ============================================================ */

  .terminal {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--foreground);
    max-width: 100%;
  }

  /* ---------- prompt line ---------- */
  .prompt-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35ch;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    margin: 1.25rem 0 0.5rem;
    padding: 0.4rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    color: var(--foreground);
    direction: ltr;
  }
  .prompt-line.subsequent {
    margin-top: 2.5rem;
  }
  .prompt-user {
    color: var(--accent);
    font-weight: 600;
  }
  .prompt-sep {
    opacity: 0.5;
  }
  .prompt-path {
    font-weight: 500;
  }
  .prompt-cmd {
    color: var(--foreground);
    opacity: 0.85;
  }
  .caret {
    display: inline-block;
    width: 0.6ch;
    height: 1em;
    background: var(--accent);
    margin-left: 0.25ch;
    transform: translateY(0.15em);
    animation: blink 1.1s steps(2, start) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }

  /* ---------- man-page preamble ---------- */
  .manpage {
    margin: 0.5rem 0 1rem;
    padding: 1rem 1.25rem;
    background: var(--muted);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    overflow-x: auto;
  }
  .man-block {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    margin: 0;
    white-space: pre;
    color: var(--foreground);
  }
  /* Arabic: resolve base direction per line so translated body text reads
     RTL while the Latin man-page scaffolding (NAME, bits) stays LTR. */
  .man-block-bidi {
    unicode-bidi: plaintext;
    white-space: pre-wrap;
  }

  /* The single allowed serif usage: the headers of the man-page block.
     We render NAME, SYNOPSIS, DESCRIPTION, LEGEND in serif via ::first-line?
     No — those are inside a <pre>. Instead we surface ONE serif element below.
     */

  /* ---------- listing total ---------- */
  .listing-total {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    opacity: 0.65;
    margin: 0.5rem 0;
    padding-left: 0.25rem;
  }

  /* ---------- listing ---------- */
  .listing {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    direction: ltr;
  }

  .row {
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .row-toggle {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    border: 0;
    padding: 0.55rem 0.25rem 0.55rem 0.25rem;
    font-family: var(--font-mono);
    color: inherit;
    cursor: pointer;
    transition: background 120ms ease, color 120ms ease;
  }

  .row-toggle:hover,
  .row-toggle:focus-visible {
    background: var(--accent);
    color: var(--background);
  }

  .row-toggle:hover .col-perms,
  .row-toggle:focus-visible .col-perms,
  .row-toggle:hover .col-year,
  .row-toggle:focus-visible .col-year,
  .row-toggle:hover .col-owner,
  .row-toggle:focus-visible .col-owner,
  .row-toggle:hover .col-cat,
  .row-toggle:focus-visible .col-cat,
  .row-toggle:hover .row-blurb,
  .row-toggle:focus-visible .row-blurb {
    color: var(--background);
    opacity: 1;
  }

  .row-toggle:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: -2px;
  }

  .row-toggle[aria-expanded="true"] .col-chevron::before {
    content: "-";
  }
  .row-toggle .col-chevron::before {
    content: "+";
  }
  .row-toggle .col-chevron {
    display: inline-block;
    width: 1.25ch;
    opacity: 0.6;
  }

  .row-line {
    display: grid;
    grid-template-columns:
      auto              /* chevron */
      11ch              /* perms */
      6ch               /* owner */
      5ch               /* year */
      12ch              /* category */
      1fr;              /* name */
    column-gap: 1ch;
    align-items: baseline;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .col-perms {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .col-owner {
    opacity: 0.65;
  }
  .col-year {
    opacity: 0.85;
    font-variant-numeric: tabular-nums;
  }
  .col-cat {
    opacity: 0.75;
    text-transform: lowercase;
  }
  .col-name {
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-blurb {
    display: block;
    padding-left: calc(1.25ch + 1ch + 11ch + 1ch); /* align under name on wide screens */
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    opacity: 0.75;
    white-space: normal;
    text-align: start;
  }

  /* ---------- row meta (external link) ---------- */
  .row-meta {
    padding: 0 0.25rem 0.55rem;
    padding-left: calc(1.25ch + 1ch + 11ch + 1ch);
    font-size: 0.8125rem;
  }
  .row-link {
    font-family: var(--font-mono);
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
    padding-bottom: 1px;
  }
  .row-link:hover,
  .row-link:focus-visible {
    background: var(--accent);
    color: var(--background);
    border-bottom-color: var(--background);
    outline: none;
  }
  .project-date {
    display: inline-block;
    margin-left: 0.8rem;
    opacity: 0.65;
    font-variant-numeric: tabular-nums;
  }
  .project-license,
  .project-tags {
    display: inline-block;
    margin-left: 0.8rem;
    opacity: 0.75;
  }
  .row-link-disabled {
    opacity: 0.45;
    border-bottom-style: dashed;
    cursor: not-allowed;
  }

  /* ---------- expanded media ---------- */
  .row-media {
    padding: 0 0.25rem 0.85rem;
    padding-left: calc(1.25ch + 1ch + 11ch + 1ch);
  }
  .row-media[hidden] {
    display: none;
  }
  .row-media img,
  .row-media video {
    display: block;
    max-width: 100%;
    width: 100%;
    max-height: 480px;
    object-fit: contain;
    border: 1px solid var(--border);
    background: var(--muted);
  }

  /* ---------- closing ---------- */
  .closing {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    margin-top: 1rem;
    opacity: 0.85;
  }
  .closing a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
  }
  .closing a:hover,
  .closing a:focus-visible {
    background: var(--accent);
    color: var(--background);
  }

  /* ---------- screen-reader only ---------- */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  /* ============================================================
     Responsive: below ~720px collapse the row into a vertical card
     so the perms column doesn't force horizontal overflow.
     ============================================================ */
  @media (max-width: 720px) {
    .terminal {
      font-size: 0.8125rem;
    }
    .man-block {
      font-size: 0.75rem;
    }
    .row-line {
      grid-template-columns: auto 1fr;
      column-gap: 1ch;
      white-space: normal;
    }
    .col-perms {
      grid-column: 2;
      grid-row: 1;
      font-size: 0.75rem;
      display: block;
    }
    .col-owner {
      display: none;
    }
    .col-year {
      grid-column: 2;
      grid-row: 2;
      font-size: 0.75rem;
      opacity: 0.7;
      display: inline;
    }
    .col-cat {
      grid-column: 2;
      grid-row: 2;
      font-size: 0.75rem;
      display: inline;
    }
    .col-cat::before {
      content: " · ";
      opacity: 0.5;
    }
    .col-name {
      grid-column: 2;
      grid-row: 3;
      white-space: normal;
      word-break: break-word;
      font-size: 0.9375rem;
    }
    .col-chevron {
      grid-row: 1 / span 3;
      align-self: start;
      padding-top: 0.15rem;
    }
    .row-blurb {
      padding-left: calc(1.25ch + 1ch);
    }
    .row-meta,
    .row-media {
      padding-left: calc(1.25ch + 1ch);
    }
  }

  @media (max-width: 420px) {
    .prompt-line {
      font-size: 0.75rem;
    }
    .man-block {
      font-size: 0.6875rem;
      line-height: 1.55;
    }
  }
</style>

<script>
  // Click / keyboard toggle for each row's media expansion.
  // Idempotent + survives Astro's ClientRouter transitions.
  function wireUpListing() {
    const toggles = document.querySelectorAll<HTMLButtonElement>(".row-toggle");
    toggles.forEach(btn => {
      if (btn.dataset.wired === "1") return;
      btn.dataset.wired = "1";

      btn.addEventListener("click", () => {
        const targetId = btn.dataset.target;
        if (!targetId) return;
        const media = document.getElementById(targetId);
        if (!media) return;
        const isOpen = btn.getAttribute("aria-expanded") === "true";
        if (isOpen) {
          btn.setAttribute("aria-expanded", "false");
          media.hidden = true;
        } else {
          btn.setAttribute("aria-expanded", "true");
          media.hidden = false;
          // For videos, kick off playback when revealed (autoplay+muted is set)
          const video = media.querySelector("video");
          if (video && video.paused) {
            video.play().catch(() => { /* autoplay can fail silently */ });
          }
        }
      });
    });
  }

  wireUpListing();
  document.addEventListener("astro:after-swap", wireUpListing);
</script>
