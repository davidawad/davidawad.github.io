---
/**
 * Landing-page call-to-action cards (investing / legal / inventing) with the
 * finance hover animations. Shared by the English, Arabic and Chinese
 * landing pages so the markup, animations and styles cannot drift; each
 * page passes its own copy via `labels`.
 */
interface CtaCopy { label: string; text: string }
interface Props {
  dir?: "rtl";
  labels: {
    aria: string;
    investing: CtaCopy;
    legal: CtaCopy;
    inventing: CtaCopy & { go: string };
    email: { before: string; link: string; after: string };
  };
}
const { labels, dir } = Astro.props;

// A looping, periodic price series so the scrolling chart repeats seamlessly.
const CANDLE_COUNT = 64;
const CANDLE_STEP = 6;
const LOOP = CANDLE_COUNT * CANDLE_STEP;
const BASE_PRICE = 126.4;
const PRICE_PER_UNIT = 0.5;
const noise = (i: number) => { const x = Math.sin(i * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); };
const harmonic = (i: number, k: number, phase: number) => Math.sin((2 * Math.PI * k * i) / CANDLE_COUNT + phase);
const price = (i: number) => 50 + 12 * harmonic(i, 1, 0) + 8 * harmonic(i, 3, 1) + 5 * harmonic(i, 7, 2) + 3 * harmonic(i, 13, 4);
const candles = Array.from({ length: CANDLE_COUNT }, (_, i) => {
  const wild = 0.4 + noise(i + 53) * 2.2;
  const open = price(i) + (noise(i) - 0.5) * 9 * wild;
  const close = price(i + 1) + (noise(i + 99) - 0.5) * 9 * wild;
  return {
    x: i * CANDLE_STEP + 3,
    wickTop: Math.min(open, close) - 1 - noise(i + 7) * 9 * wild,
    wickBottom: Math.max(open, close) + 1 + noise(i + 13) * 9 * wild,
    bodyTop: Math.min(open, close),
    bodyHeight: Math.max(Math.abs(open - close), 1),
    up: close < open,
    volume: 3 + noise(i + 31) * noise(i + 71) * 34,
    quote: (BASE_PRICE + (50 - close) * PRICE_PER_UNIT).toFixed(2),
  };
});
const tickers = [
  ["SPX", "+0.42%"], ["NDX", "+0.88%"], ["BTC", "−1.30%"], ["10Y", "+0.04"], ["VIX", "−2.10%"],
  ["DXY", "+0.15%"], ["GC", "+0.61%"], ["CL", "−0.77%"], ["ETH", "+2.40%"], ["IWM", "−0.20%"],
];
---

<ul class="cta-grid mt-6 grid gap-3 sm:grid-cols-3" aria-label={labels.aria} dir={dir}>
  <li>
    <a class="cta-card" href="https://awad.esq" target="_blank" rel="noopener noreferrer">
      <div class="cta-bg cta-tickers" aria-hidden="true">
        {[0, 1, 2].map(row => (
          <div class={`tick-row row-${row}`}>
            <div class="tick-track">
              {[0, 1].map(() => tickers.slice(row * 2).concat(tickers.slice(0, row * 2)).map(([sym, chg]) => (
                <span class={chg.startsWith("−") ? "tick down" : "tick up"}>{sym} {chg.startsWith("−") ? "▼" : "▲"} {chg}</span>
              )))}
            </div>
          </div>
        ))}
      </div>
      <span class="cta-label">{labels.legal.label}</span>
      <span class="cta-text">{labels.legal.text}</span>
      <span class="cta-go">awad.esq ↗</span>
    </a>
  </li>
  <li>
    <a class="cta-card" href="https://luminance.capital" target="_blank" rel="noopener noreferrer">
      <svg class="cta-bg cta-candles" data-loop={LOOP} data-step={CANDLE_STEP} data-quotes={candles.map(c => c.quote).join(",")} viewBox="0 0 300 100" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
        <g class="cc-grid">{[20, 40, 60, 80].map(y => <line x1="0" x2="300" y1={y} y2={y} />)}</g>
        <g transform="translate(0,26)">
      <g class="cc-track">
          {[0, 1].map(rep => (
            <g transform={`translate(${rep * LOOP},0)`}>
              {candles.map((c, i) => (
                <g class={`candle${c.up ? " up" : ""}`}>
                  {i % 5 === 0 && <line class="vgrid" x1={c.x} x2={c.x} y1="-26" y2="74" />}
                  <rect class="vol" x={c.x - 2} y={74 - c.volume} width="4" height={c.volume} />
                  <line class="wick" x1={c.x} x2={c.x} y1={c.wickTop} y2={c.wickBottom} />
                  <rect class="body" x={c.x - 2} y={c.bodyTop} width="4" height={c.bodyHeight} />
                </g>
              ))}
            </g>
          ))}
        </g>
        <g class="cc-last">
          <line x1="0" x2="300" y1="46" y2="46" />
          <rect class="tag" x="256" y="40" width="44" height="12" />
          <text class="tag-text" x="278" y="49" text-anchor="middle">126.40</text>
        </g>
      </svg>
      <span class="cta-label">{labels.investing.label}</span>
      <span class="cta-text">{labels.investing.text}</span>
      <span class="cta-go">luminance.capital ↗</span>
    </a>
  </li>
  <li>
    <a class="cta-card" href="mailto:me@davidaw.ad?subject=Fractional%20CTO">
      <svg class="cta-bg cta-curve" viewBox="0 0 300 100" preserveAspectRatio="none" aria-hidden="true">
        <polygon class="curve-area" points="0,100 0,82 24,74 48,78 72,56 96,62 120,42 144,50 168,30 192,38 216,20 240,26 264,10 300,14 300,100" />
        <polyline class="curve-line" pathLength="1" points="0,82 24,74 48,78 72,56 96,62 120,42 144,50 168,30 192,38 216,20 240,26 264,10 300,14" />
      </svg>
      <span class="cta-label">{labels.inventing.label}</span>
      <span class="cta-text">{labels.inventing.text}</span>
      <span class="cta-go">{labels.inventing.go}</span>
    </a>
  </li>
</ul>
<p class="mt-2 text-sm opacity-70" dir={dir}>
  {labels.email.before}<a class="underline underline-offset-4 decoration-dashed hover:text-accent" href="mailto:me@davidaw.ad">{labels.email.link}</a>{labels.email.after}
</p>

<style>
  .cta-grid[dir="rtl"] .cta-label { letter-spacing: 0; }
  .cta-card { display: flex; flex-direction: column; gap: .35rem; height: 100%; padding: .9rem 1rem; border: 1px solid var(--border); border-radius: .5rem; background: var(--muted); color: var(--foreground); text-decoration: none; transition: border-color 150ms ease, transform 150ms ease; }
  .cta-card:hover, .cta-card:focus-visible { border-color: var(--accent); transform: translateY(-2px); outline: none; }
  .cta-label { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); }
  .cta-text { font-weight: 600; line-height: 1.35; }
  .cta-go { margin-top: auto; padding-top: .35rem; font-family: var(--font-mono); font-size: .78rem; opacity: .7; }
  .cta-card:hover .cta-go, .cta-card:focus-visible .cta-go { opacity: 1; color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .cta-card { transition: none; } .cta-card:hover { transform: none; } }

  .cta-card { position: relative; overflow: hidden; }
  .cta-card > :not(.cta-bg) { position: relative; z-index: 1; }
  .cta-bg { display: none; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .cta-bg { display: block; position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; opacity: 0; color: var(--accent); pointer-events: none; transition: opacity 300ms ease; }
    .cta-card:hover .cta-bg, .cta-card:focus-visible .cta-bg { opacity: .32; }
    .cta-card:hover .cta-candles, .cta-card:focus-visible .cta-candles { opacity: .5; }
    .cta-card:hover .cta-tickers, .cta-card:focus-visible .cta-tickers { opacity: .2; }
    .cta-card:hover .cta-curve, .cta-card:focus-visible .cta-curve { opacity: .45; }
    /* candlesticks: a fast scrolling trading-platform chart */
    .cc-grid line, .vgrid { stroke: currentColor; stroke-width: .4; opacity: .35; }
    .candle .wick { stroke: currentColor; stroke-width: 1.3; }
    .candle .body { fill: currentColor; }
    .candle.up .body { fill: none; stroke: currentColor; stroke-width: 1.3; }
    .candle .vol { fill: currentColor; opacity: .3; }
    .cc-track { --loop: 384; animation: cc-scroll 4.2s linear infinite; animation-play-state: paused; }
    @keyframes cc-scroll { from { transform: translateX(0); } to { transform: translateX(calc(-1px * var(--loop, 384))); } }
    .cc-last > line { stroke: currentColor; stroke-width: .7; stroke-dasharray: 3 2; }
    .cc-last .tag { fill: currentColor; }
    .tag-text { font: 700 7.5px var(--font-mono); fill: var(--background); }
    .cta-card:hover .cc-track,
    .cta-card:focus-visible .cc-track { animation-play-state: running; }
    /* price tickers */
    .cta-tickers { display: flex; flex-direction: column; justify-content: space-around; font-family: var(--font-mono); font-size: .8rem; white-space: nowrap; }
    .tick-track { display: inline-flex; gap: 1.6rem; animation: tick-scroll 6s linear infinite; animation-play-state: paused; }
    .tick-row.row-1 .tick-track { animation-direction: reverse; animation-duration: 8s; }
    .tick-row.row-2 .tick-track { animation-duration: 5s; }
    .cta-card:hover .tick-track, .cta-card:focus-visible .tick-track { animation-play-state: running; }
    .tick.down { opacity: .6; }
    @keyframes tick-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    /* equity curve */
    .curve-line { fill: none; stroke: currentColor; stroke-width: 2.2; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; }
    .curve-area { fill: currentColor; opacity: .25; clip-path: inset(0 100% 0 0); }
    /* draws once on hover and holds; leaving the card drops the animation, which resets the line */
    .cta-card:hover .curve-line, .cta-card:focus-visible .curve-line { animation: curve-draw 1.8s ease-out forwards; }
    .cta-card:hover .curve-area, .cta-card:focus-visible .curve-area { animation: curve-fill 1.8s ease-out forwards; }
    @keyframes curve-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
    @keyframes curve-fill { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  }
</style>

<script>
  // Drive the price tag from the candle currently under it, so the number moves up or down in lockstep with the scrolling chart.
  const TAG_X = 278;
  document.querySelectorAll<SVGSVGElement>(".cta-candles").forEach((svg) => {
    const quotes = (svg.dataset.quotes ?? "").split(",");
    const loop = Number(svg.dataset.loop);
    const step = Number(svg.dataset.step);
    const tag = svg.querySelector<SVGTextElement>(".tag-text");
    const track = svg.querySelector<SVGGElement>(".cc-track");
    const card = svg.closest(".cta-card");
    if (!tag || !track || !card || !loop) return;
    track.style.setProperty("--loop", String(loop));
    let frame = 0;
    const tick = () => {
      const t = Number(track.getAnimations()[0]?.currentTime ?? 0);
      const duration = Number(track.getAnimations()[0]?.effect?.getComputedTiming().duration ?? 1);
      const offset = ((t % duration) / duration) * loop;
      const i = Math.floor((((TAG_X + offset) % loop) / step)) % quotes.length;
      tag.textContent = quotes[i];
      frame = requestAnimationFrame(tick);
    };
    const start = () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(tick); };
    const stop = () => cancelAnimationFrame(frame);
    card.addEventListener("pointerenter", start);
    card.addEventListener("focusin", start);
    card.addEventListener("pointerleave", stop);
    card.addEventListener("focusout", stop);
  });
</script>
