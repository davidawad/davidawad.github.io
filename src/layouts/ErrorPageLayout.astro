---
// Generic shell for numbered error pages (404, 418, 500, …).
// Each error page supplies `code` + `message` and renders its own concept
// inside the slot; page-specific styles stay in the page file so Astro
// scoping keeps them local.
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

interface Props {
  code: number;
  message: string;
  mainClass?: string;
}

const { code, message, mainClass = "" } = Astro.props;
---

<Layout title={`${code} ${message} | ${SITE.title}`}>
  <Header />

  <main id="main-content" class={`app-layout pb-16 pt-6 ${mainClass}`.trim()}>
    <slot />
  </main>

  <Footer />
</Layout>
