---
import { ClientRouter } from "astro:transitions";
import { GoogleAnalytics } from "astro-google-analytics";
import { SITE } from "@config";
import "@styles/global.css";

// Brand styleguide fonts, self-hosted via fontsource: IBM Plex Serif (display),
// IBM Plex Sans (body), IBM Plex Mono (code), Noto Naskh Arabic (ar display),
// IBM Plex Sans Arabic (ar body). unicode-range subsetting means Arabic font
// files are only fetched on pages that actually contain Arabic text.
import "@fontsource/ibm-plex-serif/300.css";
import "@fontsource/ibm-plex-serif/400.css";
import "@fontsource/ibm-plex-serif/500.css";
import "@fontsource/ibm-plex-serif/600.css";
import "@fontsource/ibm-plex-serif/700.css";
import "@fontsource/ibm-plex-serif/400-italic.css";
import "@fontsource/ibm-plex-serif/600-italic.css";
import "@fontsource/ibm-plex-sans/300.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource/noto-naskh-arabic/400.css";
import "@fontsource/noto-naskh-arabic/500.css";
import "@fontsource/noto-naskh-arabic/600.css";
import "@fontsource/noto-naskh-arabic/700.css";
import "@fontsource/ibm-plex-sans-arabic/300.css";
import "@fontsource/ibm-plex-sans-arabic/400.css";
import "@fontsource/ibm-plex-sans-arabic/500.css";
import "@fontsource/ibm-plex-sans-arabic/600.css";
import "@fontsource/ibm-plex-sans-arabic/700.css";
import sansLatin400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import serifLatin700 from "@fontsource/ibm-plex-serif/files/ibm-plex-serif-latin-700-normal.woff2?url";
import naskhArabic400 from "@fontsource/noto-naskh-arabic/files/noto-naskh-arabic-arabic-400-normal.woff2?url";
import sansArabic400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url";

const { pathname } = Astro.url;
const lang = pathname.startsWith("/ar") ? "ar" : pathname.startsWith("/zh") ? "zh" : "en";

export interface Props {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  /** Relative or absolute URL to the LLM-friendly /llms.txt version of this page.
   *  When provided, a <link rel="alternate"> tag is emitted for discoverability. */
  llmUrl?: string;
}

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.desc,
  ogImage = SITE.ogImage,
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  llmUrl,
} = Astro.props;

const socialImageURL = new URL(
  ogImage ? ogImage : SITE.ogImage,
  Astro.url.origin
).href;
---

<!doctype html>
<html lang={lang} class={scrollSmooth ? "scroll-smooth" : ""}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload the critical body/heading fonts for the page's language -->
    {lang === "ar" ? (
      <>
        <link rel="preload" href={naskhArabic400} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={sansArabic400} as="font" type="font/woff2" crossorigin />
      </>
    ) : (
      <>
        <link rel="preload" href={sansLatin400} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={serifLatin700} as="font" type="font/woff2" crossorigin />
      </>
    )}

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* LLM-friendly plain-text version of this page (llms.txt convention) */}
    {llmUrl && (
      <link
        rel="alternate"
        type="text/plain"
        title="LLM-friendly version"
        href={llmUrl}
      />
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS Feed for davidaw.ad"
      href="https://davidaw.ad/rss.xml"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <meta name="theme-color" content="" />

    {
      import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <!-- Prevent FOUC: set theme immediately before page renders -->
    <script is:inline>
      (function () {
        const primaryColorScheme = "";
        const currentTheme = localStorage.getItem("theme");

        function getPreferTheme() {
          if (currentTheme) return currentTheme;
          if (primaryColorScheme) return primaryColorScheme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        const themeValue = getPreferTheme();
        document.firstElementChild?.setAttribute("data-theme", themeValue);

        window.theme = {
          themeValue: themeValue,
          getTheme: () => window.theme.themeValue,
          setTheme: val => {
            window.theme.themeValue = val;
          },
        };
      })();
    </script>

    <GoogleAnalytics id="G-B29WM3F6QJ" />
  </head>
  <body>
    <slot />
    <script src="../scripts/theme.ts"></script>
    <script is:inline data-astro-rerun>
      function applyTashkil() {
        if (document.documentElement.lang !== "ar") return;
        const main = document.getElementById("main-content");
        if (!main || main.dataset.tashkil === "1") return;

        // Wait for Kawkab Mono fonts to load before cloning, so both layers
        // use the same font metrics and produce identical line-breaking
        const kawkabFonts = [...document.fonts].filter(f =>
          f.family.includes("Kawkab Mono Base") || f.family.includes("Kawkab Mono Mark")
        );
        if (kawkabFonts.some(f => f.status !== "loaded")) {
          Promise.all(kawkabFonts.map(f => f.load())).then(applyTashkil);
          return;
        }

        main.dataset.tashkil = "1";

        // Wrap existing content in #tashkil-base (stays in normal flow, sizes main)
        const base = document.createElement("div");
        base.id = "tashkil-base";
        while (main.firstChild) base.appendChild(main.firstChild);
        main.appendChild(base);

        function buildMark() {
          const existing = document.getElementById("tashkil-mark");
          if (existing) existing.remove();

          const mark = base.cloneNode(true);
          mark.id = "tashkil-mark";
          mark.setAttribute("aria-hidden", "true");
          mark.style.cssText = "";
          mark.querySelectorAll("svg, img, video, canvas, iframe, button, input, select, textarea, script, style").forEach(el => {
            el.style.visibility = "hidden";
          });
          base.appendChild(mark);
        }

        // Append mark INSIDE base so it shares the exact same width/padding context
        base.style.position = "relative";
        buildMark();

        // Re-clone mark after KaTeX finishes rendering (it renders async into the DOM).
        // The mark lives INSIDE base, so base.querySelectorAll(".katex") counts both the
        // original content AND the cloned mark. We must subtract the mark's own count to
        // get the true count of the original content — otherwise the comparison is always
        // true on any page with math and buildMark() loops until the 5s disconnect, pegging
        // the CPU and hanging the renderer.
        const observer = new MutationObserver(() => {
          const mark = document.getElementById("tashkil-mark");
          const markKatex = mark ? mark.querySelectorAll(".katex").length : 0;
          const baseKatex = base.querySelectorAll(".katex").length - markKatex;
          if (baseKatex > markKatex) buildMark();
        });
        observer.observe(base, { childList: true, subtree: true });
        setTimeout(() => observer.disconnect(), 5000);
      }

      applyTashkil();
      document.addEventListener("astro:after-swap", function () {
        const main = document.getElementById("main-content");
        if (main) {
          delete main.dataset.tashkil;
          // Unwrap: move base children back to main, remove mark
          const base = document.getElementById("tashkil-base");
          const mark = document.getElementById("tashkil-mark");
          if (base) while (base.firstChild) main.insertBefore(base.firstChild, base);
          base?.remove();
          mark?.remove();
        }
        applyTashkil();
      });
    </script>
  </body>
</html>
